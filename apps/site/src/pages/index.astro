---
import Base from "../layouts/Base.astro";

const heading = "The Linux kernel, compiled to WebAssembly, running in your browser.";
---

<Base
  title="lowland: the Linux kernel, compiled to WebAssembly, running in your browser"
  heading={heading}
  description="Linux ported to WebAssembly, not emulated. Open a shell in your browser, or embed the same sandbox in your own JavaScript app."
>
  <h1 slot="middle" class="intro">{heading}</h1>

  <main class="root-stage">
    <section class="machine" id="terminal" aria-label="Interactive Linux terminal">
      <pre class="terminal-placeholder" data-terminal-placeholder aria-live="polite">Loading Lowland Linux...
Fetching the kernel and root filesystem.

</pre>
      <div class="terminal" data-terminal aria-busy="true"></div>
    </section>
  </main>
  <script src="../scripts/site.ts"></script>
</Base>
