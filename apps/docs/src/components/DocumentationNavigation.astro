---
import { getDocsSections } from "../lib/docs";

interface Props {
  current: string;
}

const { current } = Astro.props;
const sections = await getDocsSections();
---

<nav aria-label="Documentation">
  {sections.map(({ heading, items }) => (
    <div>
      <h3>{heading}</h3>
      <ul>
        {items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.id === current ? "page" : undefined}>
              {item.code ? <code>{item.label}</code> : item.label}
            </a>
            {item.id === current && (
              <div class="current-toc">
                <slot />
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}
</nav>

<style>
  nav {
    display: flex;
    flex-direction: column;
    gap: 1.375rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  h3 {
    font-size: 0.8125rem;
    font-weight: inherit;
    letter-spacing: 0;
    color: var(--muted);
    margin-block-end: 0.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
    color: var(--prose);
  }

  a {
    color: inherit;
    text-decoration: none;
    transition: color 120ms;

    &:hover,
    &[aria-current="page"] {
      color: var(--code-foreground);
    }

    &[aria-current="page"] {
      font-weight: 500;
    }
  }

  /* "On this page", folded under the current page's link wherever the
     dedicated table-of-contents column doesn't fit. */
  .current-toc {
    padding: 0.4375rem 0 0.1875rem 0.875rem;
  }

  @media (min-width: 72rem) {
    .current-toc {
      display: none;
    }
  }
</style>
