---
interface Item {
  href: string;
  label: string;
}

interface Props {
  items: Item[];
  heading?: boolean;
}

const { items, heading = false } = Astro.props;
---

<nav aria-label="On this page">
  {heading && <h2>On this page</h2>}
  <ul>
    {items.map((item) => (
      <li>
        <a href={item.href}>{item.label}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  nav {
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  h2 {
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: 0;
    color: var(--muted);
    margin-block-end: 0.5rem;
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4375rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a {
    color: var(--muted);
    transition: color 120ms;

    &:hover {
      color: var(--code-foreground);
    }
  }
</style>
