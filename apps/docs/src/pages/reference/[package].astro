---
import type { Document } from "@deno/doc";
import type { MarkdownHeading } from "astro";

import ReferenceDocumentation from "../../components/ReferenceDocumentation.astro";
import Docs from "../../layouts/Docs.astro";
import { buildReference } from "../../lib/reference-model";
import { generateReferenceDocs } from "../../lib/reference-docs";
import { referencePackages, type ReferencePackage } from "../../lib/reference-packages";
import { renderPackageReadme } from "../../lib/reference-readme";

interface Props {
  pkg: ReferencePackage;
  document: Document;
}

export async function getStaticPaths() {
  const paths = [];
  for (const pkg of referencePackages) {
    paths.push({
      params: { package: pkg.slug },
      props: { pkg, document: await generateReferenceDocs(pkg) },
    });
  }
  return paths;
}

const { pkg, document } = Astro.props;
const readme = await renderPackageReadme(pkg);
const groups = buildReference(pkg, document);
const headings: MarkdownHeading[] = [
  ...readme.headings.filter(({ depth }) => depth === 2),
  ...groups.flatMap((group) => [
    { depth: 2, slug: group.id, text: group.title },
    ...group.entries.map((entry) => ({ depth: 3, slug: entry.id, text: entry.name })),
  ]),
];
---

<Docs
  title={pkg.name}
  description={pkg.description}
  current={`reference:${pkg.slug}`}
  headings={headings}
  markdownHref={`/reference/${pkg.slug}.md`}
>
  <h1><code>{pkg.name}</code></h1>
  <Fragment set:html={readme.html} />
  <ReferenceDocumentation document={document} groups={groups} />
</Docs>

<style>
  h1 code {
    font-size: inherit;
  }
</style>
