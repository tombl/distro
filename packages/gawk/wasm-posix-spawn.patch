+/*
+ * spawn_shell_command --- run "/bin/sh -c command" through posix_spawn.
+ *
+ * WebAssembly Linux has no fork(); children are created by posix_spawn
+ * (clone + execve).  The fd redirections the old fork children performed
+ * between fork() and exec() are expressed as posix_spawn file actions by the
+ * callers.  SIGPIPE is reset to its default disposition in the child, matching
+ * the set_sigpipe_to_default() calls the fork paths used.
+ */
+static pid_t
+spawn_shell_command(const char *command, posix_spawn_file_actions_t *file_actions)
+{
+	pid_t pid;
+	posix_spawnattr_t attr;
+	sigset_t sigpipe;
+	char *argv[] = { (char *) "sh", (char *) "-c", (char *) command, NULL };
+	int rc;
+
+	posix_spawnattr_init(& attr);
+	sigemptyset(& sigpipe);
+	sigaddset(& sigpipe, SIGPIPE);
+	posix_spawnattr_setsigdefault(& attr, & sigpipe);
+	posix_spawnattr_setflags(& attr, POSIX_SPAWN_SETSIGDEF);
+	rc = posix_spawn(& pid, "/bin/sh", file_actions, & attr, argv, environ);
+	posix_spawnattr_destroy(& attr);
+	if (rc != 0) {
+		errno = rc;
+		return -1;
+	}
+	return pid;
+}
+
+/*
+ * no_fork --- stand-in for fork() on the pseudo-tty coprocess path.
+ *
+ * The pty coprocess setup needs setsid()/ioctl(TIOCSCTTY) in the child, which
+ * posix_spawn cannot express.  wasm has no /dev/ptmx, so that path is never
+ * taken at run time; this keeps it compiling and makes it fail cleanly (the
+ * caller then falls back to an ordinary pipe coprocess).
+ */
+static pid_t
+no_fork(void)
+{
+	errno = ENOSYS;
+	return -1;
+}
