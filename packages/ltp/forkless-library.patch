+/*
+ * wasm has no vfork(). Run the command in a copy-clone child instead: musl's
+ * callback clone without CLONE_VM gives a child with a private copy of the
+ * parent's memory on a fresh stack (fork-like, single-threaded parent only),
+ * which is all this redirect-and-exec helper needs.
+ */
+/* musl gates clone() behind _GNU_SOURCE, which this old-API unit does not set;
+ * declare the callback form we use (clone itself is defined in libc). */
+int clone(int (*)(void *), void *, int, void *, ...);
+
+struct tst_cmd_child_args {
+	const char *const *argv;
+	int stdout_fd;
+	int stderr_fd;
+};
+
+static int tst_cmd_child(void *arg)
+{
+	struct tst_cmd_child_args *a = arg;
+
+	if (a->stdout_fd != -1) {
+		close(STDOUT_FILENO);
+		dup2(a->stdout_fd, STDOUT_FILENO);
+	}
+
+	if (a->stderr_fd != -1) {
+		close(STDERR_FILENO);
+		dup2(a->stderr_fd, STDERR_FILENO);
+	}
+
+	execvp(a->argv[0], (char *const *)a->argv);
+	_exit(254);
+}
