+/*
+ * tst_clone.h poisons the bare clone() identifier to steer tests toward
+ * SAFE_CLONE/clone3. fork_testrun() deliberately wants musl's fork-like
+ * callback clone (no CLONE_VM, a copied-memory child on a fresh stack), so
+ * take the real declaration back for the rest of this file.
+ */
+#undef clone
+
+/*
+ * wasm has no fork(). fork_testrun() supervises the test in a child that must
+ * be a memory copy of the parent (the test reads setup state and bumps result
+ * counters), so it uses musl's callback clone without CLONE_VM:
+ * clone(fn, stack, SIGCHLD, arg) yields a child with a private COPY of the
+ * parent's memory running fn on a fresh stack -- fork-like, but valid only
+ * from a single-threaded parent, which the library is at this point.
+ *
+ * The results page is no longer shared (see setup_ipc), so the child bumps
+ * counters in its own copy and writes the final struct results back over a
+ * pipe just before exiting; the parent folds them in after waitpid. A child
+ * killed by the timeout writes nothing, the parent's read() sees EOF, and the
+ * run is counted broken -- the same outcome the original fork path produced
+ * for a killed child.
+ */
+static int result_pipe[2] = { -1, -1 };
+static int child_result_fd = -1;
+
+static void flush_child_results(void)
+{
+	if (child_result_fd < 0 || !results)
+		return;
+
+	/* Best effort; a short/absent write leaves the parent to see broken. */
+	if (write(child_result_fd, results, sizeof(*results)) < 0)
+		return;
+}
+
+static int testrun_child(void *arg LTP_ATTRIBUTE_UNUSED)
+{
+	SAFE_CLOSE(result_pipe[0]);
+	child_result_fd = result_pipe[1];
+	atexit(flush_child_results);
+
+	tst_disable_oom_protection(0);
+	SAFE_SIGNAL(SIGALRM, SIG_DFL);
+	SAFE_SIGNAL(SIGUSR1, SIG_DFL);
+	SAFE_SIGNAL(SIGTERM, SIG_DFL);
+	SAFE_SIGNAL(SIGINT, SIG_DFL);
+	SAFE_SETPGID(0, 0);
+	testrun();
+
+	return 0;
+}
