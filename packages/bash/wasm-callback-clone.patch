+                              args->parse_flags | SEVAL_NOHIST);
+    }
+
+  last_command_exit_value = rc;
+  rc = run_exit_trap ();
+#if defined (PROCESS_SUBSTITUTION)
+  unlink_fifo_list ();
+#endif
+  exit (rc);
+}
