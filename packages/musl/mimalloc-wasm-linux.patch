diff --git a/src/options.c b/src/options.c
index 5146b1e..a32e30c 100644
--- a/src/options.c
+++ b/src/options.c
@@ -442,16 +442,39 @@ static _Atomic(size_t) warning_count; // = 0;  // when >= max_warning_count stop
 // variables on demand. This is why we use a _mi_preloading test on such
 // platforms. However, C code generator may move the initial thread local address
 // load before the `if` and we therefore split it out in a separate function.
+// The pthread TLS model must not reintroduce compiler TLS through this
+// diagnostic-only recursion guard.
+#if MI_TLS_MODEL_PTHREADS
+static pthread_key_t recurse_key = MI_PTHREAD_KEY_INVALID;
+static pthread_once_t recurse_once = PTHREAD_ONCE_INIT;
+
+static void mi_recurse_key_init(void) {
+  if (pthread_key_create(&recurse_key, NULL) != 0) {
+    recurse_key = MI_PTHREAD_KEY_INVALID;
+  }
+}
+#else
 static mi_decl_thread bool recurse = false;
+#endif
 
 static mi_decl_noinline bool mi_recurse_enter_prim(void) {
+  #if MI_TLS_MODEL_PTHREADS
+  pthread_once(&recurse_once, &mi_recurse_key_init);
+  if (recurse_key == MI_PTHREAD_KEY_INVALID || pthread_getspecific(recurse_key) != NULL) return false;
+  return (pthread_setspecific(recurse_key, (void*)1) == 0);
+  #else
   if (recurse) return false;
   recurse = true;
   return true;
+  #endif
 }
 
 static mi_decl_noinline void mi_recurse_exit_prim(void) {
+  #if MI_TLS_MODEL_PTHREADS
+  if (recurse_key != MI_PTHREAD_KEY_INVALID) pthread_setspecific(recurse_key, NULL);
+  #else
   recurse = false;
+  #endif
 }
 
 static bool mi_recurse_enter(void) {
