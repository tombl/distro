diff --git a/src/malloc/mimalloc/glue.c b/src/malloc/mimalloc/glue.c
new file mode 100644
index 00000000..83e5a30b
--- /dev/null
+++ b/src/malloc/mimalloc/glue.c
@@ -0,0 +1,49 @@
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <malloc.h>
+#include <mimalloc.h>
+
+void *__libc_malloc_impl(size_t len)
+{
+	void *p = mi_malloc(len);
+	if (!p) errno = ENOMEM;
+	return p;
+}
+weak_alias(__libc_malloc_impl, malloc);
+
+void __libc_free(void *p)
+{
+	mi_free(p);
+}
+
+void *__libc_realloc(void *p, size_t len)
+{
+	void *new = mi_realloc(p, len);
+	if (!new) errno = ENOMEM;
+	return new;
+}
+
+void *aligned_alloc(size_t align, size_t len)
+{
+	if ((align & -align) != align) {
+		errno = EINVAL;
+		return 0;
+	}
+	if (align < sizeof(void *)) align = sizeof(void *);
+	void *p = mi_malloc_aligned(len, align);
+	if (!p) errno = ENOMEM;
+	return p;
+}
+
+size_t malloc_usable_size(void *p)
+{
+	return p ? mi_usable_size(p) : 0;
+}
+
+/* There is no detached bootstrap mapping to donate in static wasm binaries. */
+void __malloc_donate(char *start, char *end)
+{
+	(void)start;
+	(void)end;
+}
diff --git a/src/malloc/mimalloc/mimalloc.c b/src/malloc/mimalloc/mimalloc.c
new file mode 100644
index 00000000..f4aaf420
--- /dev/null
+++ b/src/malloc/mimalloc/mimalloc.c
@@ -0,0 +1,27 @@
+/* Build upstream mimalloc as one libc-internal translation unit. */
+#ifndef _DEFAULT_SOURCE
+#define _DEFAULT_SOURCE
+#endif
+#define MI_LIBC_MUSL 1
+#define MI_BUILD_RELEASE 1
+#define MI_NO_GETENV 1
+/* wasm linear memory has no page-protection primitive. */
+#define MI_GUARDED 0
+#define MI_PRIM_WASM_LINUX 1
+#define MI_TLS_MODEL_PTHREADS 1
+
+/* wasm has no virtual address reservation; use the primitive's reusable
+ * extents directly instead of reserving mimalloc's minimum 8 MiB arena. */
+#define MI_DEFAULT_DISALLOW_ARENA_ALLOC 1
+
+#include <features.h>
+#ifdef weak
+#undef weak
+#endif
+#include <pthread.h>
+#include <stdint.h>
+
+/* Avoid mimalloc's compiler-TLS fallback for its fast thread identifier. */
+#define MI_PRIM_THREAD_ID() ((uintptr_t)pthread_self())
+
+#include <static.c>
diff --git a/src/malloc/mimalloc/README b/src/malloc/mimalloc/README
new file mode 100644
index 00000000..55777118
--- /dev/null
+++ b/src/malloc/mimalloc/README
@@ -0,0 +1,19 @@
+This allocator directory adapts an external, unmodified mimalloc source tree
+to musl's private allocation entry points. Select it with MALLOC_DIR=mimalloc
+and set MIMALLOC_SRC to the mimalloc source root.
+
+The mimalloc objects are placed first in libc.a. Their public malloc symbol is
+weak, matching musl's bootstrap allocator, so an ordinary malloc reference
+selects mimalloc while a strong application-provided allocator still wins.
+
+Mimalloc uses its supported pthread-key TLS model. This avoids adding compiler
+TLS to programs that otherwise have none while preserving per-thread heaps and
+normal pthread-key cleanup. Before the initial thread pointer exists, musl's
+main-thread TLS setup allocates through the bootstrap allocator directly.
+The documented MI_PRIM_THREAD_ID hook uses pthread_self; the accompanying
+platform patch also keeps mimalloc's diagnostic recursion guard in a pthread
+key, so linking malloc does not create an application TLS segment.
+
+The platform memory primitives remain part of mimalloc. wasm32 Linux needs a
+primitive that allocates with sbrk and retains/coalesces freed extents because
+linear memory cannot shrink and this musl target intentionally has no mmap.
