{
  "compilerOptions": {
    "noEmit": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "target": "es2022",
    "lib": [
      "es2022",
      "esnext.disposable",
      "webworker",
      "webworker.iterable",
      "webworker.asynciterable"
    ],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
