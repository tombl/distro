{
  "name": "lowland",
  "version": "0.0.0",
  "description": "Linux machines in Node and browsers, as a JavaScript API and the lowland command line.",
  "homepage": "https://docs.low.land/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tombl/distro.git",
    "directory": "packages/lowland"
  },
  "bin": {
    "lowland": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p test",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "test:unit": "node --test test/cli.test.ts"
  },
  "dependencies": {
    "@lowland/guest": "workspace:^",
    "@lowland/image": "workspace:^",
    "@lowland/kernel": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.20"
  }
}
