{
  "name": "@tombl/linux-guest",
  "version": "0.0.0",
  "description": "A bootable Linux guest for JavaScript with processes, files, and networking.",
  "homepage": "https://linux.tombl.dev/reference/linux-guest/",
  "license": "MIT AND GPL-2.0-only AND (GPL-2.0-only WITH Linux-syscall-note)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tombl/distro.git",
    "directory": "packages/linux-guest"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tombl/linux": "0.0.0"
  }
}
