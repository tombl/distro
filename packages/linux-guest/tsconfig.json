{
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "esnext.disposable",
      "es2024.promise",
      "webworker",
      "webworker.iterable",
      "webworker.asynciterable"
    ],
    "skipLibCheck": true,
    "types": ["node"],
    "declaration": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts"]
}
