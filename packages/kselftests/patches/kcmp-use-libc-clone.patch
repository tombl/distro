+		       args->pipe_write_fd, (unsigned long)(void *)&epoll_slot);
+	if (ret) {
+		printf("FAIL: 0 expected but %d returned (%s)\n",
+			ret, strerror(errno));
+		ksft_inc_fail_cnt();
+		ret = -1;
+	} else {
+		printf("PASS: 0 returned as expected\n");
+		ksft_inc_pass_cnt();
+	}
+
+	return ksft_get_fail_cnt() ? KSFT_FAIL : KSFT_PASS;
