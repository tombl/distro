# Kernel and guest SDK assets live under /static/<version>/, which changes
# every build, and the rootfs under its content hash, so they never change in
# place: cache them immutable and skip revalidation (the guest's workers load
# these many times per boot). index.html and rootfs.ext4.sha256 revalidate so a
# new deploy is picked up immediately.
/static/*
  Cache-Control: public, max-age=31556952, immutable

/rootfs-*.ext4.gz
  Cache-Control: public, max-age=31556952, immutable

/*
  Cross-Origin-Embedder-Policy: require-corp
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: cross-origin
