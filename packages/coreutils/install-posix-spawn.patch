wasm has no fork(); run the strip helper through posix_spawn (clone+exec),
the platform's sanctioned child-process primitive, instead of fork+execlp.

--- a/src/install.c
+++ b/src/install.c
@@ -24,6 +24,7 @@
 #include <pwd.h>
 #include <grp.h>
 #include <selinux/label.h>
+#include <spawn.h>
 #include <sys/wait.h>
 
 #include "system.h"
@@ -492,31 +493,24 @@
 {
   int status;
   bool ok = false;
-  pid_t pid = fork ();
-
-  switch (pid)
-    {
-    case -1:
-      error (0, errno, _("fork system call failed"));
-      break;
-    case 0:			/* Child. */
-      {
-        char const *safe_name = name;
-        if (name && *name == '-')
-          safe_name = file_name_concat (".", name, nullptr);
-        execlp (strip_program, strip_program, safe_name, nullptr);
-        error (EXIT_FAILURE, errno, _("cannot run %s"),
-               quoteaf (strip_program));
-      }
-    default:			/* Parent. */
-      if (waitpid (pid, &status, 0) < 0)
-        error (0, errno, _("waiting for strip"));
-      else if (! WIFEXITED (status) || WEXITSTATUS (status))
-        error (0, 0, _("strip process terminated abnormally"));
-      else
-        ok = true;      /* strip succeeded */
-      break;
-    }
+  pid_t pid;
+  char const *safe_name = name;
+  if (name && *name == '-')
+    safe_name = file_name_concat (".", name, nullptr);
+  char *argv[] = { (char *) strip_program, (char *) safe_name, nullptr };
+
+  /* This platform has no fork(); spawn strip with posix_spawn
+     (clone+exec), which needs no fork+exec split.  */
+  int err = posix_spawnp (&pid, strip_program, nullptr, nullptr,
+                          argv, environ);
+  if (err != 0)
+    error (0, err, _("cannot run %s"), quoteaf (strip_program));
+  else if (waitpid (pid, &status, 0) < 0)
+    error (0, errno, _("waiting for strip"));
+  else if (! WIFEXITED (status) || WEXITSTATUS (status))
+    error (0, 0, _("strip process terminated abnormally"));
+  else
+    ok = true;      /* strip succeeded */
   return ok;
 }
 
