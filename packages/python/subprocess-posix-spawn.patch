+# Becomes True below iff _posixsubprocess is importable. On fork-less platforms
+# (e.g. wasm) that module is not built and subprocess uses os.posix_spawn only.
+_HAVE_FORK_EXEC = False
 
 if _mswindows:
     import _winapi
@@ -103,7 +106,12 @@
