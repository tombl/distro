@@ -0,0 +1,82 @@
+//! wasm32 and wasm64 Linux on the tombl/linux NOMMU kernel port: musl libc,
+//! static executables linked through the clang driver for the same triple.
+//!
+//! Unlike WALI (`linux_wasm`), which imports Linux syscalls from the host and
+//! uses an LP64-style ABI on wasm32, these targets use the ordinary C ABI for
+//! their pointer width and enter the kernel through musl.
+
+use crate::spec::{
+    BinaryFormat, Cc, Env, LinkSelfContainedDefault, LinkerFlavor, Os, PanicStrategy, RelocModel,
+    TargetOptions, TlsModel, cvs,
+};
+
+pub(crate) fn opts(clang_target: &'static str, max_memory: &'static str) -> TargetOptions {
+    let pre_link_args = TargetOptions::link_args(
+        LinkerFlavor::WasmLld(Cc::Yes),
+        &[
+            clang_target,
+            // The kernel instantiates every process against one shared memory
+            // and calls through the function table for signal handlers and
+            // clone callbacks.
+            "-Wl,--import-memory",
+            "-Wl,--shared-memory",
+            max_memory,
+            "-Wl,--export-table",
+            // wasm-ld's default 64 KiB shadow stack is too small for ordinary
+            // programs; match the 8 MiB Linux convention.
+            "-Wl,-z,stack-size=8388608",
+            // LLD only implements C++-like demangling, which doesn't match
+            // Rust's mangling scheme.
+            "-Wl,--no-demangle",
+        ],
+    );
+
+    TargetOptions {
+        os: Os::Linux,
+        env: Env::Musl,
+        families: cvs!["wasm", "unix"],
+        is_like_wasm: true,
+        binary_format: BinaryFormat::Wasm,
+
+        // The clang driver for the target supplies musl's crt1, libc and the
+        // compiler runtime; nothing is self-contained in the Rust toolchain.
+        linker: Some("clang".into()),
+        linker_flavor: LinkerFlavor::WasmLld(Cc::Yes),
+        pre_link_args,
+        link_self_contained: LinkSelfContainedDefault::False,
+
+        // Executables are always static; the kernel has no dynamic loader.
+        crt_static_default: true,
+        crt_static_respected: true,
+        dynamic_linking: false,
+        relocation_model: RelocModel::Static,
+
+        // wasm cannot unwind yet.
+        panic_strategy: PanicStrategy::Abort,
+
+        // Threads are wasm threads over the shared memory; TLS is per-instance
+        // and only local-exec is implemented for wasm in LLVM.
+        has_thread_local: true,
+        tls_model: TlsModel::LocalExec,
+        singlethread: false,
+        max_atomic_width: Some(64),
+
+        // musl's crt1 `_start` fetches argv from the kernel and calls the weak
+        // `__main_void`, whose libc definition forwards the real argc/argv to
+        // `__main_argc_argv`.
+        entry_name: "__main_argc_argv".into(),
+        main_needs_argc_argv: true,
+
+        eh_frame_header: false,
+        emit_debug_gdb_scripts: false,
+        // See https://bugs.llvm.org/show_bug.cgi?id=52442.
+        generate_arange_section: false,
+        // Symbol visibility handles this for wasm.
+        limit_rdylib_exports: false,
+
+        // Matches the musl sysroot, which clang compiles with these features.
+        features: "+atomics,+bulk-memory,+mutable-globals,+sign-ext".into(),
+
+        ..Default::default()
+    }
+}
