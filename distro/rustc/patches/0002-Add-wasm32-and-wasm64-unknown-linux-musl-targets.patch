+        metadata: TargetMetadata {
+            description: Some("WebAssembly 64-bit Linux (tombl/linux) with musl-libc".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-p10:8:8-p20:8:8-i64:64-i128:128-n32:64-S128-ni:1:10:20".into(),
+        arch: Arch::Wasm64,
+        // FIXME: provisional 16 GiB limit; shared memories need a maximum and
