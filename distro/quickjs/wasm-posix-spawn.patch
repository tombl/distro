+static int js_os_spawn(pid_t *pid, const char *file, char **argv, char **envp,
+                       const int std_fds[3], const char *cwd, bool use_path)
+{
+    posix_spawn_file_actions_t actions;
+    DIR *dir = NULL;
+    struct dirent *entry;
+    uint32_t i;
+    int ret;
+
+    ret = posix_spawn_file_actions_init(&actions);
+    if (ret)
+        return ret;
+
+    for(i = 0; i < 3; i++) {
+        if (std_fds[i] != i) {
+            ret = posix_spawn_file_actions_adddup2(&actions, std_fds[i], i);
+            if (ret)
+                goto done;
+        }
+    }
+
+    /* QuickJS children inherit only stdin, stdout, and stderr. musl has no
+       closefrom spawn action, so turn the parent's current descriptor set into
+       ordered close actions after the stdio duplications. */
+    dir = opendir("/proc/self/fd");
+    if (!dir) {
+        ret = errno;
+        goto done;
+    }
+    for(;;) {
+        char *end;
+        long fd;
+
+        errno = 0;
+        entry = readdir(dir);
+        if (!entry) {
+            ret = errno;
+            break;
+        }
+        fd = strtol(entry->d_name, &end, 10);
+        if (end != entry->d_name && *end == '\0' &&
+            fd >= 3 && fd <= INT_MAX) {
+            ret = posix_spawn_file_actions_addclose(&actions, fd);
+            if (ret)
+                break;
+        }
+    }
+    closedir(dir);
+    dir = NULL;
+    if (ret)
+        goto done;
+
+    if (cwd) {
+        ret = posix_spawn_file_actions_addchdir_np(&actions, cwd);
+        if (ret)
+            goto done;
+    }
+
+    if (use_path)
+        ret = posix_spawnp(pid, file, &actions, NULL, argv, envp);
+    else
+        ret = posix_spawn(pid, file, &actions, NULL, argv, envp);
+
+ done:
+    if (dir)
+        closedir(dir);
+    posix_spawn_file_actions_destroy(&actions);
+    return ret;
+}
+
