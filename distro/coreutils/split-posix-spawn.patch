wasm has no fork(); run split --filter's shell child through posix_spawn.
The descriptor plumbing the forked child did before exec (closing inherited
pipes, moving the read end onto stdin, restoring SIGPIPE) becomes posix_spawn
file actions and attributes.

--- a/src/split.c
+++ b/src/split.c
@@ -25,6 +25,7 @@
 #include <stdio.h>
 #include <getopt.h>
 #include <signal.h>
+#include <spawn.h>
 #include <sys/types.h>
 #include <sys/wait.h>
 
@@ -509,38 +510,51 @@
