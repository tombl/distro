+#ifdef __wasm__
+/*
+ * musl's daemon() is fork-based and therefore unavailable.  Recreate its
+ * double-fork continuation with private-memory callback clones: the first
+ * clone detaches the session, the second becomes the service process, and
+ * each intermediate exits immediately, so the final daemon is reparented
+ * like a real double-forked child.
+ */
+struct uuidd_daemon_args {
+	const char *pidfile_path;
+	struct uuidd_cxt_t *cxt;
+	int socket_fd;
+	int pidfile_fd;
+	char *first_stack;
+};
+
+static void __attribute__((__noreturn__))
+server_loop_service(const char *pidfile_path, struct uuidd_cxt_t *uuidd_cxt,
+		    int s, int fd_pidfile);
+
+static int uuidd_daemon_second(void *data)
+{
+	struct uuidd_daemon_args *args = data;
+	uid_t euid;
+
+	/* This runs on stack #2, so stack #1 is safe to release. */
+	free(args->first_stack);
+	euid = geteuid();
+	if (setreuid(euid, euid) < 0)
+		err(EXIT_FAILURE, "setreuid");
+	server_loop_service(args->pidfile_path, args->cxt,
+			    args->socket_fd, args->pidfile_fd);
+}
+
+static int uuidd_daemon_first(void *data)
+{
+	const size_t stack_size = 128 * 1024;
+	struct uuidd_daemon_args *args = data;
+	char *stack;
+	pid_t pid;
+
+	if (setsid() < 0)
+		err(EXIT_FAILURE, "setsid");
+	stack = xmalloc(stack_size);
+	pid = clone(uuidd_daemon_second, stack + stack_size, SIGCHLD, args);
+	free(stack);
+	if (pid < 0)
+		err(EXIT_FAILURE, "clone");
+	_exit(EXIT_SUCCESS);
+}
+
+static void __attribute__((__noreturn__))
+create_daemon(struct uuidd_daemon_args *args)
+{
+	const size_t stack_size = 128 * 1024;
+	char *stack;
+	int fd;
+	pid_t pid;
+
+	/* Match musl daemon(0, 0): redirect before either clone. */
+	if (chdir("/") < 0)
+		err(EXIT_FAILURE, "chdir");
+	fd = open("/dev/null", O_RDWR);
+	if (fd < 0)
+		err(EXIT_FAILURE, "open /dev/null");
+	if (dup2(fd, STDIN_FILENO) < 0 ||
+	    dup2(fd, STDOUT_FILENO) < 0 ||
+	    dup2(fd, STDERR_FILENO) < 0)
+		err(EXIT_FAILURE, "dup2 /dev/null");
+	if (fd > STDERR_FILENO)
+		close(fd);
+
+	stack = xmalloc(stack_size);
+	args->first_stack = stack;
+	pid = clone(uuidd_daemon_first, stack + stack_size, SIGCHLD, args);
+	free(stack);
+	if (pid < 0)
+		err(EXIT_FAILURE, "clone");
+	_exit(EXIT_SUCCESS);
+}
+#else
 static void create_daemon(void)
 {
