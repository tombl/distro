+#ifdef __wasm__
+struct restricted_path_child_args {
+	const char *path;
+	int (*oper)(const char *path, char **result, void *data);
+	void *data;
+	int read_fd;
+	int write_fd;
+};
+
+static int restricted_path_child(void *data)
+{
+	struct restricted_path_child_args *args = data;
+	char *result = NULL;
+	ssize_t len;
+
+	close(args->read_fd);
+	errno = 0;
+
+	if (drop_permissions() != 0)
+		result = NULL;
+	else
+		args->oper(args->path, &result, args->data);
+
+	len = result ? (ssize_t) strlen(result) :
+		  errno ? -errno : -EINVAL;
+	write_all(args->write_fd, (char *) &len, sizeof(len));
+	if (result)
+		write_all(args->write_fd, result, len);
+	return 0;
+}
+#endif
+
 /*
  * Fork, drop permissions, and call oper() and return result.
  */
