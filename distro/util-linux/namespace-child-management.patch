+struct unshare_child_args {
+	int kill_child_signo;
+#ifdef HAVE_PIDFD_OPEN
+	int fd_parent_pid;
+#endif
+	uid_t mapuser, real_euid;
+	gid_t mapgroup, real_egid;
+	struct map_range *usermap, *groupmap;
+	int setgrpcmd, unshare_flags;
+	unsigned long propagation;
+	const char *newinterp, *newroot, *newdir, *procmnt, *binfmt_mnt;
+	int force_gid, force_uid, keepcaps;
+	gid_t gid;
+	uid_t uid;
+	int argc, optind;
+	char **argv;
+	int restore_sigmask, restore_forward_actions, close_fd_bind;
+	sigset_t oldsigset;
+	struct sigaction old_sigterm, old_sigint;
+};
+
+static void __attribute__((__noreturn__))
+run_unshare_child(struct unshare_child_args *ca)
+{
+	child_pid = 0;
+	if (ca->restore_forward_actions &&
+	    (sigaction(SIGTERM, &ca->old_sigterm, NULL) != 0 ||
+	     sigaction(SIGINT, &ca->old_sigint, NULL) != 0))
+		err(EXIT_FAILURE, _("signal handler restore failed"));
+	if (ca->restore_sigmask &&
+	    sigprocmask(SIG_SETMASK, &ca->oldsigset, NULL))
+		err(EXIT_FAILURE, _("sigprocmask restore failed"));
+	if (ca->close_fd_bind >= 0)
+		close(ca->close_fd_bind);
+
+	if (ca->kill_child_signo != 0) {
+		if (prctl(PR_SET_PDEATHSIG, ca->kill_child_signo) < 0)
+			err(EXIT_FAILURE, "prctl failed");
+#ifdef HAVE_PIDFD_OPEN
+		if (ca->fd_parent_pid != -1) {
+			struct pollfd pollfds[1] = {
+				{ .fd = ca->fd_parent_pid, .events = POLLIN }
+			};
+			int nfds = poll(pollfds, 1, 0);
+
+			if (nfds < 0)
+				err(EXIT_FAILURE, "poll parent pidfd failed");
+			if (nfds)
+				exit(EXIT_FAILURE);
+			close(ca->fd_parent_pid);
+		}
+#endif
+	}
+
+	if (ca->mapuser != MAX_OF_UINT_TYPE(uid_t) && !ca->usermap)
+		map_id(_PATH_PROC_UIDMAP, ca->mapuser, ca->real_euid);
+	if (ca->mapgroup != MAX_OF_UINT_TYPE(gid_t) && !ca->groupmap) {
+		if (ca->setgrpcmd == SETGROUPS_ALLOW)
+			errx(EXIT_FAILURE, _("options --setgroups=allow and "
+					       "--map-group are mutually exclusive"));
+		setgroups_control(SETGROUPS_DENY);
+		map_id(_PATH_PROC_GIDMAP, ca->mapgroup, ca->real_egid);
+	}
+	if (ca->setgrpcmd != SETGROUPS_NONE)
+		setgroups_control(ca->setgrpcmd);
+	if ((ca->unshare_flags & CLONE_NEWNS) && ca->propagation)
+		set_propagation(ca->propagation);
+
+	if (ca->newinterp && is_fixed(ca->newinterp) && ca->newroot) {
+		if (mount("binfmt_misc", _PATH_PROC_BINFMT_MISC, "binfmt_misc",
+			  MS_NOSUID | MS_NOEXEC | MS_NODEV, NULL) != 0)
+			err(EXIT_FAILURE, _("mount %s failed"), _PATH_PROC_BINFMT_MISC);
+		load_interp(_PATH_PROC_BINFMT_MISC, ca->newinterp);
+	}
+	if (ca->newroot) {
+		if (chroot(ca->newroot) != 0)
+			err(EXIT_FAILURE, _("cannot change root directory to '%s'"),
+			    ca->newroot);
+		ca->newdir = ca->newdir ?: "/";
+	}
+	if (ca->newdir && chdir(ca->newdir))
+		err(EXIT_FAILURE, _("cannot change directory to %s"), ca->newdir);
+	if (ca->procmnt) {
+		if (!ca->newroot && ca->propagation != (MS_PRIVATE | MS_REC)) {
+			int rc = mount("none", ca->procmnt, NULL,
+				       MS_PRIVATE | MS_REC, NULL);
+
+			if (rc != 0 && errno != EINVAL)
+				err(EXIT_FAILURE,
+				    _("cannot change %s filesystem propagation"),
+				    ca->procmnt);
+		}
+		if (mount("proc", ca->procmnt, "proc",
+			  MS_NOSUID | MS_NOEXEC | MS_NODEV, NULL) != 0)
+			err(EXIT_FAILURE, _("mount %s failed"), ca->procmnt);
+	}
+	if (ca->binfmt_mnt &&
+	    mount("binfmt_misc", ca->binfmt_mnt, "binfmt_misc",
+		  MS_NOSUID | MS_NOEXEC | MS_NODEV, NULL) != 0)
+		err(EXIT_FAILURE, _("mount %s failed"), ca->binfmt_mnt);
+	if (ca->newinterp && !(is_fixed(ca->newinterp) && ca->newroot))
+		load_interp(ca->binfmt_mnt, ca->newinterp);
+	if (ca->force_gid) {
+		if (setgroups(0, NULL) != 0)
+			err(EXIT_FAILURE, _("setgroups failed"));
+		if (setgid(ca->gid) < 0)
+			err(EXIT_FAILURE, _("setgid() failed"));
+	}
+	if (ca->force_uid && setuid(ca->uid) < 0)
+		err(EXIT_FAILURE, _("setuid() failed"));
+	if (ca->keepcaps && (ca->unshare_flags & CLONE_NEWUSER))
+		cap_permitted_to_ambient();
+	if (ca->optind < ca->argc) {
+		execvp(ca->argv[ca->optind], ca->argv + ca->optind);
+		errexec(ca->argv[ca->optind]);
+	}
+	exec_shell();
+}
