+#ifdef __wasm__
+struct bind_ns_child_args {
+	int fd;
+	pid_t ppid;
+};
+
+static int bind_ns_child(void *data)
+{
+	struct bind_ns_child_args *ca = data;
+	uint64_t ch;
+
+	if (read_all(ca->fd, (char *) &ch, sizeof(ch)) != sizeof(ch) ||
+	    ch != PIPE_SYNC_BYTE)
+		err(EXIT_FAILURE, _("failed to read eventfd"));
+	close(ca->fd);
+	bind_ns_files(ca->ppid);
+	return EXIT_SUCCESS;
+}
+#endif
+
 static pid_t bind_ns_files_from_child(int *fd)
 {
 	pid_t child, ppid = getpid();
 
+#ifdef __wasm__
+	const size_t stack_size = 128 * 1024;
+	struct bind_ns_child_args args;
+	void *stack;
+
+	*fd = eventfd(0, 0);
+	if (*fd < 0)
+		err(EXIT_FAILURE, _("eventfd failed"));
+	args.fd = *fd;
+	args.ppid = ppid;
+	stack = malloc(stack_size);
+	if (!stack)
+		err(EXIT_FAILURE, _("clone failed"));
+	child = clone(bind_ns_child, (char *) stack + stack_size,
+		      SIGCHLD, &args);
+	free(stack);
+	if (child < 0)
+		err(EXIT_FAILURE, _("clone failed"));
+	return child;
+#else
 	child = fork_and_wait(fd);
 	if (child)
 		return child;
 
 	bind_ns_files(ppid);
 	exit(EXIT_SUCCESS);
+#endif
 }
 
