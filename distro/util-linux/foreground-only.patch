 static void __attribute__((__format__ (__printf__, 3, 4)))
 	execute(struct more_control *ctl, char *filename, const char *cmd, ...)
 {
+#ifdef __wasm__
+	const size_t stack_size = 128 * 1024;
+	struct more_child_args child_args;
+	pid_t id;
+	va_list argp;
+	char *arg;
+	char **args;
+	char *stack;
+	sigset_t runtime_mask;
+	int argcount = 0, clone_errno;
+
+	va_start(argp, cmd);
+	while ((arg = va_arg(argp, char *)))
+		argcount++;
+	va_end(argp);
+	args = xcalloc(argcount + 1, sizeof(char *));
+	va_start(argp, cmd);
+	argcount = 0;
+	while ((arg = va_arg(argp, char *)))
+		args[argcount++] = arg;
+	va_end(argp);
+
+	fflush(NULL);
+	stack = xmalloc(stack_size);
+	child_args = (struct more_child_args) {
+		.ctl = ctl,
+		.cmd = cmd,
+		.argv = args,
+	};
+	/* Native more forks while all signalfd signals are blocked.  Block the
+	 * same set before clone so no bridge handler can run in the child before
+	 * more_command_child() restores dispositions and the native child mask. */
+	if (sigprocmask(SIG_BLOCK, &ctl->sigset, &runtime_mask) < 0) {
+		id = -1;
+		clone_errno = errno;
+	} else {
+		id = clone(more_command_child, stack + stack_size, SIGCHLD, &child_args);
+		clone_errno = errno;
+		if (sigprocmask(SIG_SETMASK, &runtime_mask, NULL) < 0) {
+			int mask_errno = errno;
+
+			free(stack);
+			free(args);
+			if (id > 0) {
+				pid_t waited;
+
+				do {
+					waited = wait(NULL);
+				} while (waited > 0 || (waited < 0 && errno == EINTR));
+			}
+			more_signals_cleanup(ctl);
+			reset_tty(ctl);
+			errno = mask_errno;
+			err(EXIT_FAILURE, _("cannot restore signal mask"));
+		}
+	}
+	free(stack);
+	errno = clone_errno;
+	if (id > 0) {
+		pid_t waited;
+
+		do {
+			waited = wait(NULL);
+		} while (waited > 0 || (waited < 0 && errno == EINTR));
+	} else
+		fputs(_("can't fork\n"), stderr);
+	free(args);
+#else
 	pid_t id;
 	va_list argp;
 	char *arg;
