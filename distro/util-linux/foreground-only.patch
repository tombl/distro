+#ifdef __wasm__
+static const int more_signals[] = {
+	SIGINT, SIGQUIT, SIGTSTP, SIGCONT, SIGWINCH
+};
+static struct more_control *volatile more_signal_target;
+
+static int more_signal_index(int signum)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++)
+		if (more_signals[i] == signum)
+			return i;
+	return -1;
+}
+
+static void more_signal_handler(int signum)
+{
+	struct more_control *ctl = more_signal_target;
+	int saved_errno = errno;
+	int idx;
+
+	if (ctl && (idx = more_signal_index(signum)) >= 0) {
+		sig_atomic_t bit = (sig_atomic_t) 1 << idx;
+		unsigned char byte = (unsigned char) signum;
+		int opposite;
+
+		/* Match the kernel pending-set rule: generating SIGCONT discards a
+		 * pending stop signal, and generating a stop discards SIGCONT. */
+		if (signum == SIGCONT)
+			opposite = more_signal_index(SIGTSTP);
+		else if (signum == SIGTSTP)
+			opposite = more_signal_index(SIGCONT);
+		else
+			opposite = -1;
+		if (opposite >= 0)
+			ctl->sigpending &= ~((sig_atomic_t) 1 << opposite);
+
+		if (!(ctl->sigpending & bit)) {
+			ctl->sigpending |= bit;
+			if (write(ctl->sigpipe[1], &byte, sizeof(byte)) < 0) {
+				/* EAGAIN is harmless: the pending bit retains the event. */
+			}
+		}
+	}
+	errno = saved_errno;
+}
+
+static void more_signals_rollback(struct more_control *ctl, size_t installed)
+{
+	while (installed > 0) {
+		installed--;
+		if (sigismember(&ctl->installed_sigset,
+				more_signals[installed]) == 1)
+			sigaction(more_signals[installed],
+				  &ctl->original_sigactions[installed], NULL);
+	}
+	if (ctl->sigpipe[0] >= 0)
+		close(ctl->sigpipe[0]);
+	if (ctl->sigpipe[1] >= 0)
+		close(ctl->sigpipe[1]);
+	ctl->sigpipe[0] = ctl->sigpipe[1] = -1;
+	sigprocmask(SIG_SETMASK, &ctl->original_sigmask, NULL);
+}
+
+static int more_signals_setup(struct more_control *ctl)
+{
+	struct sigaction action;
+	sigset_t runmask;
+	int errsv;
+	size_t i;
+
+	ctl->sigpipe[0] = ctl->sigpipe[1] = -1;
+	ctl->sigpending = 0;
+	sigemptyset(&ctl->sigset);
+	sigemptyset(&ctl->installed_sigset);
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++)
+		sigaddset(&ctl->sigset, more_signals[i]);
+
+	/* Keep setup and rollback atomic with respect to every handled signal. */
+	if (sigprocmask(SIG_BLOCK, &ctl->sigset, &ctl->original_sigmask) < 0)
+		return -1;
+	if (pipe2(ctl->sigpipe, O_CLOEXEC | O_NONBLOCK) < 0) {
+		errsv = errno;
+		sigprocmask(SIG_SETMASK, &ctl->original_sigmask, NULL);
+		errno = errsv;
+		return -1;
+	}
+
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = more_signal_handler;
+	action.sa_mask = ctl->sigset;
+	action.sa_flags = SA_RESTART;
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++) {
+		if (sigaction(more_signals[i], NULL,
+			      &ctl->original_sigactions[i]) < 0)
+			goto fail;
+		/* Like the native signalfd path, honor inherited ignored signals. */
+		if (ctl->original_sigactions[i].sa_handler == SIG_IGN)
+			continue;
+		if (sigaction(more_signals[i], &action, NULL) < 0)
+			goto fail;
+		sigaddset(&ctl->installed_sigset, more_signals[i]);
+	}
+
+	if (more_signal_target) {
+		errno = EBUSY;
+		goto fail;
+	}
+	more_signal_target = ctl;
+	runmask = ctl->original_sigmask;
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++)
+		if (sigismember(&ctl->installed_sigset, more_signals[i]) == 1)
+			sigdelset(&runmask, more_signals[i]);
+	if (sigprocmask(SIG_SETMASK, &runmask, NULL) < 0) {
+		more_signal_target = NULL;
+		goto fail;
+	}
+	return 0;
+
+fail:
+	errsv = errno;
+	more_signals_rollback(ctl, i);
+	errno = errsv;
+	return -1;
+}
+
+static void more_signals_cleanup(struct more_control *ctl)
+{
+	size_t i;
+
+	if (ctl->sigpipe[0] < 0)
+		return;
+	/* No handler may retain or write through ctl after the pipe is closed. */
+	sigprocmask(SIG_BLOCK, &ctl->installed_sigset, NULL);
+	if (more_signal_target == ctl)
+		more_signal_target = NULL;
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++)
+		if (sigismember(&ctl->installed_sigset, more_signals[i]) == 1)
+			sigaction(more_signals[i], &ctl->original_sigactions[i], NULL);
+	close(ctl->sigpipe[0]);
+	close(ctl->sigpipe[1]);
+	ctl->sigpipe[0] = ctl->sigpipe[1] = -1;
+	sigprocmask(SIG_SETMASK, &ctl->original_sigmask, NULL);
+}
+
+static void more_signals_child_restore(struct more_control *ctl)
+{
+	sigset_t childmask = ctl->original_sigmask;
+	size_t i;
+
+	/* A native fork child inherits more's blocked signalfd mask. */
+	sigprocmask(SIG_BLOCK, &ctl->installed_sigset, NULL);
+	if (more_signal_target == ctl)
+		more_signal_target = NULL;
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++) {
+		if (sigismember(&ctl->installed_sigset, more_signals[i]) == 1)
+			sigaction(more_signals[i], &ctl->original_sigactions[i], NULL);
+		sigaddset(&childmask, more_signals[i]);
+	}
+	close(ctl->sigpipe[0]);
+	close(ctl->sigpipe[1]);
+	ctl->sigpipe[0] = ctl->sigpipe[1] = -1;
+	sigprocmask(SIG_SETMASK, &childmask, NULL);
+}
+#endif
