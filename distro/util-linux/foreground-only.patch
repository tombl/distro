+#ifdef __wasm__
+static int more_process_signals(struct more_control *ctl)
+{
+	sig_atomic_t pending;
+	sigset_t oldmask;
+	unsigned char buf[32];
+	int read_errno;
+	ssize_t sz;
+	size_t i;
+
+	if (sigprocmask(SIG_BLOCK, &ctl->installed_sigset, &oldmask) < 0)
+		return -1;
+	pending = ctl->sigpending;
+	ctl->sigpending = 0;
+	do {
+		sz = read(ctl->sigpipe[0], buf, sizeof(buf));
+	} while (sz > 0 || (sz < 0 && errno == EINTR));
+	read_errno = errno;
+	if (sz < 0 && read_errno != EAGAIN && read_errno != EWOULDBLOCK) {
+		sigprocmask(SIG_SETMASK, &oldmask, NULL);
+		errno = read_errno;
+		return -1;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(more_signals); i++) {
+		if (!(pending & ((sig_atomic_t) 1 << i)))
+			continue;
+		switch (more_signals[i]) {
+		case SIGINT:
+			more_exit(ctl);
+			break;
+		case SIGQUIT:
+			sigquit_handler(ctl);
+			break;
+		case SIGTSTP:
+			sigtstp_handler(ctl);
+			break;
+		case SIGCONT:
+			sigcont_handler(ctl);
+			break;
+		case SIGWINCH:
+			sigwinch_handler(ctl);
+			break;
+		default:
+			abort();
+		}
+	}
+	/* Keep the handled set blocked until dispatch completes. In particular,
+	 * a newly delivered SIGCONT must not race a snapshotted SIGTSTP and be
+	 * consumed before sigtstp_handler() stops this process. */
+	if (sigprocmask(SIG_SETMASK, &oldmask, NULL) < 0)
+		return -1;
+	return 0;
+}
+#endif
