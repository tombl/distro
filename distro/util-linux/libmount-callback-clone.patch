+static int next_mount_child(void *data)
+{
+	struct next_mount_child_args *args = data;
+	char *pattern;
+	int rc;
+
+	args->cxt->pid = getpid();
+	mnt_context_enable_fork(args->cxt, FALSE);
+	rc = mnt_context_apply_fs(args->cxt, args->fs);
+	if (!rc) {
+		pattern = args->cxt->fstype_pattern;
+		args->cxt->fstype_pattern = NULL;
+		rc = mnt_context_mount(args->cxt);
+		args->cxt->fstype_pattern = pattern;
+	}
+	next_mount_exit(args->cxt, rc);
+}
