Preserve setsid's forked path with a private-memory callback clone.

Unlike posix_spawn, the callback child can perform both setsid() and the
optional TIOCSCTTY before exec.  clone() without CLONE_VM gives the child its
own wasm memory snapshot and a distinct process/session identity.

--- a/sys-utils/setsid.c
+++ b/sys-utils/setsid.c
@@ -15,6 +15,9 @@
  * 2008-08-20 Daniel Kahn Gillmor <dkg@fifthhorseman.net>
  * - if forked, wait on child process and emit its return code.
  */
+#ifdef __wasm__
+# include <sched.h>
+#endif
 #include <getopt.h>
 #include <stdio.h>
 #include <stdlib.h>
@@ -26,6 +29,26 @@
 #include "c.h"
 #include "nls.h"
 #include "closestream.h"
+#ifdef __wasm__
+# include "xalloc.h"
+
+struct setsid_child_args {
+	char **argv;
+	int ctty;
+};
+
+static int setsid_child(void *data)
+{
+	struct setsid_child_args *args = data;
+
+	if (setsid() < 0)
+		err(EXIT_FAILURE, _("setsid failed"));
+	if (args->ctty && ioctl(STDIN_FILENO, TIOCSCTTY, 1))
+		err(EXIT_FAILURE, _("failed to set the controlling terminal"));
+	execvp(args->argv[0], args->argv);
+	errexec(args->argv[0]);
+}
+#endif
 
 static void __attribute__((__noreturn__)) usage(void)
 {
@@ -96,6 +119,30 @@
 	}
 
 	if (forcefork || getpgrp() == getpid()) {
+#ifdef __wasm__
+		const size_t stack_size = 128 * 1024;
+		struct setsid_child_args args = {
+			.argv = argv + optind,
+			.ctty = ctty
+		};
+		void *stack = xmalloc(stack_size);
+
+		pid = clone(setsid_child, (char *) stack + stack_size,
+			    SIGCHLD, &args);
+		free(stack);
+		if (pid < 0)
+			err(EXIT_FAILURE, _("clone"));
+		if (pid > 0) {
+			/* parent */
+			if (!status)
+				return EXIT_SUCCESS;
+			if (wait(&status) != pid)
+				err(EXIT_FAILURE, "wait");
+			if (WIFEXITED(status))
+				return WEXITSTATUS(status);
+			err(status, _("child %d did not exit normally"), pid);
+		}
+#else
 		pid = fork();
 		switch (pid) {
 		case -1:
@@ -113,6 +160,7 @@
 				return WEXITSTATUS(status);
 			err(status, _("child %d did not exit normally"), pid);
 		}
+#endif
 	}
 	if (setsid() < 0)
 		/* cannot happen */
