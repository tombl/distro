+#ifdef __wasm__
+static int handle_one_signal(struct ul_pty *pty, int signum,
+			     const struct signalfd_siginfo *child_info)
+{
+	struct signalfd_siginfo info = { .ssi_signo = signum };
+	int rc = 0;
+
+	switch (signum) {
+	case SIGCHLD:
+		DBG(SIG, ul_debugobj(pty, " get signal SIGCHLD"));
+		info.ssi_pid = child_info->ssi_pid;
+		info.ssi_code = child_info->ssi_code;
+		info.ssi_status = child_info->ssi_status;
+
+		if (pty->child > 0 && pty->callbacks.child_wait) {
+			if (info.ssi_pid != 0) {
+				if (info.ssi_code == CLD_EXITED
+				    || info.ssi_code == CLD_KILLED
+				    || info.ssi_code == CLD_DUMPED)
+					pty->callbacks.child_wait(pty->callback_data,
+								  pty->child);
+				else if (info.ssi_code == CLD_STOPPED
+					 && info.ssi_status == SIGSTOP
+					 && pty->callbacks.child_sigstop)
+					pty->callbacks.child_sigstop(pty->callback_data,
+								     pty->child);
+			}
+		} else if (pty->child > 0) {
+			int status;
+			pid_t pid;
+
+			/* Consume every state currently queued for the managed child. */
+			for (;;) {
+				pid = waitpid(pty->child, &status,
+					      WNOHANG | WUNTRACED | WCONTINUED);
+				if (pid < 0 && errno == EINTR)
+					continue;
+				if (pid <= 0)
+					break;
+				if (WIFEXITED(status) || WIFSIGNALED(status)) {
+					if (pty->callbacks.child_die)
+						pty->callbacks.child_die(pty->callback_data,
+								 pty->child, status);
+					ul_pty_set_child(pty, (pid_t) -1);
+					break;
+				}
+				if (WIFSTOPPED(status) && WSTOPSIG(status) == SIGSTOP
+				    && pty->callbacks.child_sigstop)
+					pty->callbacks.child_sigstop(pty->callback_data,
+								     pty->child);
+			}
+			if (pid < 0 && errno != ECHILD)
+				return -errno;
+		}
+
+		if (pty->child <= 0) {
+			DBG(SIG, ul_debugobj(pty, " no child, setting leaving timeout"));
+			pty->poll_timeout = 10;
+			timerclear(&pty->next_callback_time);
+		}
+		return 0;
+	case SIGWINCH:
+		DBG(SIG, ul_debugobj(pty, " get signal SIGWINCH"));
+		if (pty->isterm) {
+			ioctl(STDIN_FILENO, TIOCGWINSZ, (char *) &pty->win);
+			ioctl(pty->slave, TIOCSWINSZ, (char *) &pty->win);
+
+			if (pty->callbacks.log_signal)
+				rc = pty->callbacks.log_signal(pty->callback_data,
+							       &info, (void *) &pty->win);
+		}
+		break;
+	case SIGHUP:
+		FALLTHROUGH;
+	case SIGTERM:
+		FALLTHROUGH;
+	case SIGINT:
+		FALLTHROUGH;
+	case SIGQUIT:
+		DBG(SIG, ul_debugobj(pty, " get signal SIG{TERM,INT,QUIT}"));
+		pty->delivered_signal = signum;
+		if (pty->child > 0)
+			kill(pty->child, SIGTERM);
+
+		if (pty->callbacks.log_signal)
+			rc = pty->callbacks.log_signal(pty->callback_data,
+						       &info, (void *) &pty->win);
+		break;
+	case SIGUSR1:
+		DBG(SIG, ul_debugobj(pty, " get signal SIGUSR1"));
+		if (pty->callbacks.flush_logs)
+			rc = pty->callbacks.flush_logs(pty->callback_data);
+		break;
+	default:
+		abort();
+	}
+
+	return rc;
+}
+
+static int handle_signal(struct ul_pty *pty, int fd)
+{
+	static const int signal_order[] = {
+		SIGCHLD, SIGWINCH, SIGALRM, SIGHUP, SIGTERM, SIGINT, SIGQUIT, SIGUSR1
+	};
+	sig_atomic_t pending;
+	struct signalfd_siginfo child_info = { .ssi_signo = SIGCHLD };
+	sigset_t oldmask;
+	unsigned char buf[64];
+	ssize_t bytes;
+	size_t i;
+	int rc = 0;
+
+	DBG(SIG, ul_debugobj(pty, " handle signals on fd=%d", fd));
+
+	if (sigprocmask(SIG_BLOCK, &pty->handled_signals, &oldmask) < 0)
+		return -errno;
+	do
+		bytes = read(fd, buf, sizeof(buf));
+	while (bytes > 0);
+	if (bytes < 0 && errno != EAGAIN && errno != EINTR)
+		rc = -errno;
+	pending = pty->sigpending;
+	child_info.ssi_pid = pty->sigchld_pid;
+	child_info.ssi_code = pty->sigchld_code;
+	child_info.ssi_status = pty->sigchld_status;
+	pty->sigpending = 0;
+	if (sigprocmask(SIG_SETMASK, &oldmask, NULL) < 0 && rc == 0)
+		rc = -errno;
+	if (rc)
+		return rc;
+
+	for (i = 0; i < ARRAY_SIZE(signal_order); i++) {
+		int signum = signal_order[i];
+
+		if (pending & (sig_atomic_t) (1U << signum)) {
+			rc = handle_one_signal(pty, signum, &child_info);
+			if (rc)
+				break;
+		}
+	}
+	return rc;
+}
