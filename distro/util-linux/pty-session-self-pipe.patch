+#ifdef __wasm__
+static struct ul_pty *active_signal_pty;
+
+static void pty_signal_handler(int signum, siginfo_t *info, void *ucontext __attribute__((__unused__)))
+{
+	struct ul_pty *pty = active_signal_pty;
+	int errsv = errno;
+	unsigned char byte = 1;
+
+	if (pty) {
+		sig_atomic_t bit = (sig_atomic_t) (1U << signum);
+
+		/* Match standard pending-signal coalescing: retain the first
+		 * SIGCHLD record until the main loop snapshots it. */
+		if (signum == SIGCHLD && info && !(pty->sigpending & bit)) {
+			pty->sigchld_pid = info->si_pid;
+			pty->sigchld_code = info->si_code;
+			pty->sigchld_status = info->si_status;
+		}
+		pty->sigpending |= bit;
+		if (pty->sigpipe_write >= 0)
+			(void) write(pty->sigpipe_write, &byte, sizeof(byte));
+	}
+	errno = errsv;
+}
+#endif
