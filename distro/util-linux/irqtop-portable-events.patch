+#ifdef __wasm__
+struct irqtop_signal_state {
+	int pipefd[2];
+	sigset_t original_mask;
+	sigset_t installed_set;
+	sigset_t run_mask;
+	struct sigaction original_actions[ARRAY_SIZE(irqtop_signals)];
+	volatile sig_atomic_t pending;
+};
+
+static struct irqtop_signal_state *volatile irqtop_signal_target;
+
+static int irqtop_signal_index(int signum)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(irqtop_signals); i++)
+		if (irqtop_signals[i] == signum)
+			return i;
+	return -1;
+}
+
+static void irqtop_signal_handler(int signum)
+{
+	struct irqtop_signal_state *state = irqtop_signal_target;
+	int saved_errno = errno;
+	int idx;
+
+	if (state && (idx = irqtop_signal_index(signum)) >= 0) {
+		sig_atomic_t bit = (sig_atomic_t) 1 << idx;
+		unsigned char byte = (unsigned char) signum;
+
+		if (!(state->pending & bit)) {
+			state->pending |= bit;
+			if (write(state->pipefd[1], &byte, sizeof(byte)) < 0) {
+				/* EAGAIN is harmless: the pending bit retains the event. */
+			}
+		}
+	}
+	errno = saved_errno;
+}
+
+static void irqtop_signals_rollback(struct irqtop_signal_state *state,
+				    size_t installed)
+{
+	while (installed > 0) {
+		installed--;
+		if (sigismember(&state->installed_set,
+				irqtop_signals[installed]) == 1)
+			sigaction(irqtop_signals[installed],
+				  &state->original_actions[installed], NULL);
+	}
+	if (state->pipefd[0] >= 0)
+		close(state->pipefd[0]);
+	if (state->pipefd[1] >= 0)
+		close(state->pipefd[1]);
+	state->pipefd[0] = state->pipefd[1] = -1;
+	sigprocmask(SIG_SETMASK, &state->original_mask, NULL);
+}
+
+static int irqtop_signals_setup(struct irqtop_signal_state *state)
+{
+	struct sigaction action;
+	sigset_t set;
+	int errsv;
+	size_t i;
+
+	state->pipefd[0] = state->pipefd[1] = -1;
+	state->pending = 0;
+	sigemptyset(&set);
+	sigemptyset(&state->installed_set);
+	for (i = 0; i < ARRAY_SIZE(irqtop_signals); i++)
+		sigaddset(&set, irqtop_signals[i]);
+	if (sigprocmask(SIG_BLOCK, &set, &state->original_mask) < 0)
+		return -1;
+	if (pipe2(state->pipefd, O_CLOEXEC | O_NONBLOCK) < 0) {
+		errsv = errno;
+		sigprocmask(SIG_SETMASK, &state->original_mask, NULL);
+		errno = errsv;
+		return -1;
+	}
+
+	memset(&action, 0, sizeof(action));
+	action.sa_handler = irqtop_signal_handler;
+	action.sa_mask = set;
+	action.sa_flags = SA_RESTART;
+	for (i = 0; i < ARRAY_SIZE(irqtop_signals); i++) {
+		if (sigaction(irqtop_signals[i], NULL,
+			      &state->original_actions[i]) < 0)
+			goto fail;
+		if (state->original_actions[i].sa_handler == SIG_IGN)
+			continue;
+		if (sigaction(irqtop_signals[i], &action, NULL) < 0)
+			goto fail;
+		sigaddset(&state->installed_set, irqtop_signals[i]);
+	}
+	if (irqtop_signal_target) {
+		errno = EBUSY;
+		goto fail;
+	}
+	irqtop_signal_target = state;
+	state->run_mask = state->original_mask;
+	for (i = 0; i < ARRAY_SIZE(irqtop_signals); i++)
+		if (sigismember(&state->installed_set, irqtop_signals[i]) == 1)
+			sigdelset(&state->run_mask, irqtop_signals[i]);
+	if (sigprocmask(SIG_SETMASK, &state->run_mask, NULL) < 0) {
+		irqtop_signal_target = NULL;
+		goto fail;
+	}
+	return 0;
+
+fail:
+	errsv = errno;
+	irqtop_signals_rollback(state, i);
+	errno = errsv;
+	return -1;
+}
+
+static void irqtop_signals_cleanup(struct irqtop_signal_state *state)
+{
+	size_t i;
+
+	if (state->pipefd[0] < 0)
+		return;
+	sigprocmask(SIG_BLOCK, &state->installed_set, NULL);
+	if (irqtop_signal_target == state)
+		irqtop_signal_target = NULL;
+	for (i = 0; i < ARRAY_SIZE(irqtop_signals); i++)
+		if (sigismember(&state->installed_set, irqtop_signals[i]) == 1)
+			sigaction(irqtop_signals[i], &state->original_actions[i], NULL);
+	close(state->pipefd[0]);
+	close(state->pipefd[1]);
+	state->pipefd[0] = state->pipefd[1] = -1;
+	sigprocmask(SIG_SETMASK, &state->original_mask, NULL);
+}
+
+static sig_atomic_t irqtop_signals_pending(struct irqtop_signal_state *state)
+{
+	unsigned char buf[32];
+	sig_atomic_t pending;
+	ssize_t bytes;
+
+	if (sigprocmask(SIG_BLOCK, &state->installed_set, NULL) < 0)
+		err(EXIT_FAILURE, _("sigprocmask failed"));
+	pending = state->pending;
+	state->pending = 0;
+	do {
+		bytes = read(state->pipefd[0], buf, sizeof(buf));
+	} while (bytes > 0 || (bytes < 0 && errno == EINTR));
+	if (bytes < 0 && errno != EAGAIN && errno != EWOULDBLOCK)
+		warn(_("read failed"));
+	if (sigprocmask(SIG_SETMASK, &state->run_mask, NULL) < 0)
+		err(EXIT_FAILURE, _("sigprocmask failed"));
+	return pending;
+}
+
+static int timespec_cmp(const struct timespec *a, const struct timespec *b)
+{
+	if (a->tv_sec != b->tv_sec)
+		return a->tv_sec < b->tv_sec ? -1 : 1;
+	return (a->tv_nsec > b->tv_nsec) - (a->tv_nsec < b->tv_nsec);
+}
+
+static int timespec_add(struct timespec *a, const struct timespec *b)
+{
+	time_t seconds;
+
+	if (__builtin_add_overflow(a->tv_sec, b->tv_sec, &seconds))
+		return -1;
+	a->tv_sec = seconds;
+	a->tv_nsec += b->tv_nsec;
+	if (a->tv_nsec >= 1000000000L) {
+		if (__builtin_add_overflow(a->tv_sec, (time_t) 1, &seconds))
+			return -1;
+		a->tv_sec = seconds;
+		a->tv_nsec -= 1000000000L;
+	}
+	return 0;
+}
+
+static int deadline_timeout(const struct timespec *deadline,
+			    const struct timespec *now)
+{
+	struct timespec remaining;
+	uint64_t millis;
+
+	if (timespec_cmp(deadline, now) <= 0)
+		return 0;
+	remaining.tv_sec = deadline->tv_sec - now->tv_sec;
+	remaining.tv_nsec = deadline->tv_nsec - now->tv_nsec;
+	if (remaining.tv_nsec < 0) {
+		remaining.tv_sec--;
+		remaining.tv_nsec += 1000000000L;
+	}
+	if (remaining.tv_sec > INT_MAX / 1000)
+		return INT_MAX;
+	millis = (uint64_t) remaining.tv_sec * 1000
+		 + ((uint64_t) remaining.tv_nsec + 999999) / 1000000;
+	return millis > INT_MAX ? INT_MAX : (int) millis;
+}
