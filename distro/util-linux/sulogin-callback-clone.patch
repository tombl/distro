-					doshell++;
-				else {
-					const char *cryptbuf;
-					cryptbuf = crypt(answer, passwd);
-					if (cryptbuf == NULL)
-						warn(_("crypt failed"));
-					else if (strcmp(cryptbuf, pwd->pw_passwd) == 0)
-						doshell++;
-				}
-#ifdef HAVE_EXPLICIT_BZERO
-				explicit_bzero(answer, SULOGIN_PASSWORD_BUFSIZ);
-#endif
-				if (doshell) {
-					/* sushell() unmask signals */
-					sushell(pwd, con);
-
-					mask_signal(SIGQUIT, SIG_IGN, &saved_sigquit);
-					mask_signal(SIGTSTP, SIG_IGN, &saved_sigtstp);
-					mask_signal(SIGINT,  SIG_IGN, &saved_sigint);
-
-					fprintf(stderr, _("cannot execute su shell\n\n"));
-					break;
-				}
-				fprintf(stderr, _("Login incorrect\n\n"));
-			}
-			if (alarm_raised) {
-				tcfinal(con);
-				warnx(_("Timed out\n\n"));
-			}
-			/*
-			 * User pressed Control-D.
-			 */
-			exit(0);
+			service_console(pwd, con, opt_e);
 		case -1:
+#ifdef __wasm__
+			warn(_("child process creation failed"));
+#else
 			warn(_("fork failed"));
+#endif
 			FALLTHROUGH;
 		default:
 			break;
@@ -1334,3 +1398,39 @@ int main(int argc, char **argv)
 
 	return EXIT_SUCCESS;
 }
+#else
+int main(void)
+{
+	struct passwd pwd = { 0 };
+	struct console consoles[2] = { 0 };
+	int records[4], pipes[2], status;
+	pid_t pids[2];
+
+	if (pipe(pipes) != 0)
+		err(EXIT_FAILURE, "pipe");
+	sulogin_test_fd = pipes[1];
+	consoles[0].id = 3;
+	consoles[1].id = 7;
+	pids[0] = spawn_console(&pwd, &consoles[0], 0);
+	pids[1] = spawn_console(&pwd, &consoles[1], 0);
+	if (pids[0] < 0 || pids[1] < 0 || pids[0] == pids[1])
+		err(EXIT_FAILURE, "clone");
+	close(pipes[1]);
+	if (read_all(pipes[0], (char *) records, sizeof(records)) !=
+	    (ssize_t) sizeof(records))
+		err(EXIT_FAILURE, "child records");
+	for (size_t i = 0; i < ARRAY_SIZE(pids); i++)
+		if (waitpid(pids[i], &status, 0) != pids[i] ||
+		    !WIFEXITED(status) || WEXITSTATUS(status) != EXIT_SUCCESS)
+			err(EXIT_FAILURE, "child status");
+	if (!((records[0] == 3 && records[2] == 7) ||
+	      (records[0] == 7 && records[2] == 3)) ||
+	    !((records[1] == pids[0] || records[1] == pids[1]) &&
+	      (records[3] == pids[0] || records[3] == pids[1]) &&
+	      records[1] != records[3]))
+		errx(EXIT_FAILURE, "console dispatch");
+	printf("parent=%d children=%d,%d consoles=%d,%d\n", getpid(),
+	       pids[0], pids[1], records[0], records[2]);
+	return EXIT_SUCCESS;
+}
