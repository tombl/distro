+static void __attribute__((__noreturn__)) service_console(struct passwd *pwd,
+							  struct console *con,
+							  int force)
+{
+	setup(con);
+	while (1) {
+		const char *passwd = pwd->pw_passwd;
+		char *answer;
+		int doshell = 0;
+		int deny = !force && locked_account_password(pwd->pw_passwd);
+
+		doprompt(passwd, con, deny);
+
+		if ((answer = getpasswd(con)) == NULL)
+			break;
+		if (deny) {
+#ifdef HAVE_EXPLICIT_BZERO
+			explicit_bzero(answer, SULOGIN_PASSWORD_BUFSIZ);
+#endif
+			exit(EXIT_FAILURE);
+		}
+
+		if (!passwd[0] || locked_account_password(passwd))
+			doshell++;
+		else {
+			const char *cryptbuf = crypt(answer, passwd);
+			if (cryptbuf == NULL)
+				warn(_("crypt failed"));
+			else if (strcmp(cryptbuf, pwd->pw_passwd) == 0)
+				doshell++;
+		}
+#ifdef HAVE_EXPLICIT_BZERO
+		explicit_bzero(answer, SULOGIN_PASSWORD_BUFSIZ);
+#endif
+		if (doshell) {
+			sushell(pwd, con);
+
+			mask_signal(SIGQUIT, SIG_IGN, &saved_sigquit);
+			mask_signal(SIGTSTP, SIG_IGN, &saved_sigtstp);
+			mask_signal(SIGINT, SIG_IGN, &saved_sigint);
+
+			fprintf(stderr, _("cannot execute su shell\n\n"));
+			break;
+		}
+		fprintf(stderr, _("Login incorrect\n\n"));
+	}
+	if (alarm_raised) {
+		tcfinal(con);
+		warnx(_("Timed out\n\n"));
+	}
+	exit(EXIT_SUCCESS);
+}
+
+#if defined(__wasm__) || defined(TEST_PROGRAM_SULOGIN)
+struct sulogin_child_args {
+	struct passwd *pwd;
+	struct console *con;
+	int force;
+};
+
+#ifdef TEST_PROGRAM_SULOGIN
+static int sulogin_test_fd = -1;
+#endif
+
+static int sulogin_child(void *data)
+{
+	struct sulogin_child_args *args = data;
+
+#ifdef TEST_PROGRAM_SULOGIN
+	if (sulogin_test_fd >= 0) {
+		int record[2] = { args->con->id, getpid() };
+
+		return write(sulogin_test_fd, record, sizeof(record)) ==
+		       (ssize_t) sizeof(record) ? EXIT_SUCCESS : EXIT_FAILURE;
+	}
+#endif
+	mask_signal(SIGCHLD, SIG_DFL, NULL);
+	dup2(args->con->fd, STDERR_FILENO);
+	service_console(args->pwd, args->con, args->force);
+}
+
+static pid_t spawn_console(struct passwd *pwd, struct console *con, int force)
+{
+	const size_t stack_size = 128 * 1024;
+	struct sulogin_child_args args = {
+		.pwd = pwd, .con = con, .force = force
+	};
+	void *stack = malloc(stack_size);
+	pid_t pid;
+
+	if (!stack) {
+		errno = ENOMEM;
+		return -1;
+	}
+	pid = clone(sulogin_child, (char *) stack + stack_size,
+		    SIGCHLD, &args);
+	free(stack);
+	return pid;
+}
+#endif
