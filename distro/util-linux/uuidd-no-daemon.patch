+
+static void uuidd_signal_handler(int signum)
+{
+	struct uuidd_cxt_t *cxt = uuidd_signal_target;
+	int saved_errno = errno;
+	int idx;
+
+	if (cxt && (idx = uuidd_signal_index(signum)) >= 0) {
+		sig_atomic_t bit = (sig_atomic_t) 1 << idx;
+		unsigned char byte = (unsigned char) signum;
