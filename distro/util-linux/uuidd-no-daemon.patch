+#ifdef __wasm__
+static int uuidd_daemon_second(void *data)
+{
+	struct uuidd_daemon_args *args = data;
+	uid_t euid;
+
+	/* We are now running on stack #2, so stack #1 is safe to release. */
+	free(args->first_stack);
+	args->first_stack = NULL;
+	euid = geteuid();
+	if (setreuid(euid, euid) < 0)
+		err(EXIT_FAILURE, "setreuid");
+	server_loop_service(args->pidfile_path, args->cxt,
+			    args->socket_fd, args->pidfile_fd);
+}
+
+static int uuidd_daemon_first(void *data)
+{
+	const size_t stack_size = 128 * 1024;
+	struct uuidd_daemon_args *args = data;
+	char *stack;
+	pid_t pid;
+
+	if (setsid() < 0)
+		err(EXIT_FAILURE, "setsid");
+	stack = xmalloc(stack_size);
+	pid = clone(uuidd_daemon_second, stack + stack_size, SIGCHLD, args);
+	free(stack);
+	if (pid < 0)
+		err(EXIT_FAILURE, "clone");
+	_exit(EXIT_SUCCESS);
+}
