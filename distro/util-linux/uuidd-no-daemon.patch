+fail:
+	errsv = errno;
+	uuidd_signals_rollback(cxt, i);
+	errno = errsv;
+	return -1;
+}
+
+static void uuidd_signals_cleanup(struct uuidd_cxt_t *cxt)
+{
+	size_t i;
+
+	if (cxt->sigpipe[0] < 0)
+		return;
+	sigprocmask(SIG_BLOCK, &cxt->installed_sigset, NULL);
+	if (uuidd_signal_target == cxt)
+		uuidd_signal_target = NULL;
+	for (i = 0; i < ARRAY_SIZE(uuidd_signals); i++)
+		if (sigismember(&cxt->installed_sigset, uuidd_signals[i]) == 1)
+			sigaction(uuidd_signals[i], &cxt->original_sigactions[i], NULL);
+	close(cxt->sigpipe[0]);
+	close(cxt->sigpipe[1]);
+	cxt->sigpipe[0] = cxt->sigpipe[1] = -1;
+	sigprocmask(SIG_SETMASK, &cxt->original_sigmask, NULL);
+}
+#endif
