+	memset(&action, 0, sizeof(action));
+	action.sa_handler = uuidd_signal_handler;
+	action.sa_mask = sigset;
+	action.sa_flags = SA_RESTART;
+	for (i = 0; i < ARRAY_SIZE(uuidd_signals); i++) {
+		if (sigaction(uuidd_signals[i], NULL,
+			      &cxt->original_sigactions[i]) < 0)
+			goto fail;
+		if (cxt->original_sigactions[i].sa_handler == SIG_IGN)
+			continue;
+		if (sigaction(uuidd_signals[i], &action, NULL) < 0)
+			goto fail;
+		sigaddset(&cxt->installed_sigset, uuidd_signals[i]);
+	}
+	if (uuidd_signal_target) {
+		errno = EBUSY;
+		goto fail;
+	}
+	uuidd_signal_target = cxt;
+	runmask = cxt->original_sigmask;
+	for (i = 0; i < ARRAY_SIZE(uuidd_signals); i++)
+		if (sigismember(&cxt->installed_sigset, uuidd_signals[i]) == 1)
+			sigdelset(&runmask, uuidd_signals[i]);
