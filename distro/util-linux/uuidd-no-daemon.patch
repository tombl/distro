+	if (cxt->sigpipe[0] >= 0)
+		close(cxt->sigpipe[0]);
+	if (cxt->sigpipe[1] >= 0)
+		close(cxt->sigpipe[1]);
+	cxt->sigpipe[0] = cxt->sigpipe[1] = -1;
+	sigprocmask(SIG_SETMASK, &cxt->original_sigmask, NULL);
+}
+
+static int uuidd_signals_setup(struct uuidd_cxt_t *cxt)
+{
+	struct sigaction action;
+	sigset_t sigset, runmask;
+	int errsv;
+	size_t i;
+
+	cxt->sigpipe[0] = cxt->sigpipe[1] = -1;
+	cxt->sigpending = 0;
+	sigemptyset(&sigset);
+	sigemptyset(&cxt->installed_sigset);
+	for (i = 0; i < ARRAY_SIZE(uuidd_signals); i++)
+		sigaddset(&sigset, uuidd_signals[i]);
+	if (sigprocmask(SIG_BLOCK, &sigset, &cxt->original_sigmask) < 0)
+		return -1;
