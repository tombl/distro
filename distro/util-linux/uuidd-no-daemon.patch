+static void uuidd_signals_rollback(struct uuidd_cxt_t *cxt, size_t installed)
+{
+	while (installed > 0) {
+		installed--;
+		if (sigismember(&cxt->installed_sigset,
+				uuidd_signals[installed]) == 1)
+			sigaction(uuidd_signals[installed],
