+		if (!(cxt->sigpending & bit)) {
+			cxt->sigpending |= bit;
+			if (write(cxt->sigpipe[1], &byte, sizeof(byte)) < 0) {
+				/* EAGAIN is harmless: the pending bit retains the event. */
+			}
+		}
+	}
+	errno = saved_errno;
