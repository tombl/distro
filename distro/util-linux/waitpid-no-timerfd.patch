+#if defined(__wasm__) || defined(TEST_PROGRAM_WAITPID)
+static int deadline_msec(const struct timespec *deadline,
+			 const struct timespec *now)
+{
+	time_t sec;
+	long nsec, extra;
+	int msec;
+
+	sec = deadline->tv_sec - now->tv_sec;
+	nsec = deadline->tv_nsec - now->tv_nsec;
+	if (nsec < 0) {
+		sec--;
+		nsec += 1000000000L;
+	}
+	if (sec < 0 || (sec == 0 && nsec == 0))
+		return 0;
+	if (sec > INT_MAX / 1000)
+		return INT_MAX;
+
+	extra = (nsec + 999999L) / 1000000L;
+	msec = (int) sec * 1000;
+	return msec > INT_MAX - extra ? INT_MAX : msec + extra;
 }
+#endif
+
+#ifdef __wasm__
+static int timeout_msec(const struct waitpid_control *ctl)
+{
+	struct timespec now;
+
+	if (!ctl->timeout.tv_sec && !ctl->timeout.tv_nsec)
+		return -1;
+	if (clock_gettime(CLOCK_MONOTONIC, &now))
+		err_nosys(EXIT_FAILURE, _("could not read monotonic clock"));
+
+	return deadline_msec(&ctl->timeout_deadline, &now);
+}
+#endif
 
