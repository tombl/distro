+#else
+int main(void)
+{
+	const struct timespec zero = { 0, 0 };
+	const struct timespec one_ns = { 0, 1 };
+	const struct timespec capped = { (time_t) INT_MAX / 1000 + 10, 0 };
+	const struct timespec after_first_slice = { (time_t) INT_MAX / 1000, 0 };
+
+	if (deadline_msec(&zero, &zero) != 0 ||
+	    deadline_msec(&one_ns, &zero) != 1 ||
+	    deadline_msec(&capped, &zero) != INT_MAX ||
+	    deadline_msec(&capped, &after_first_slice) <= 0)
+		return EXIT_FAILURE;
