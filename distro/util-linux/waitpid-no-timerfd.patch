+static int open_timeoutfd(struct waitpid_control *ctl)
 {
+#ifdef __wasm__
+	struct timespec now;
+	time_t time_t_max = (time_t) (UINTMAX_MAX >>
+		((sizeof(uintmax_t) - sizeof(time_t)) * CHAR_BIT + 1));
+	bool saturated = false;
+
+	if (!ctl->timeout.tv_sec && !ctl->timeout.tv_nsec)
+		return -1;
+	if (ctl->timeout.tv_sec < 0 || ctl->timeout.tv_nsec < 0) {
+		errno = EINVAL;
+		err_nosys(EXIT_FAILURE, _("could not set timer"));
+	}
+
+	if (clock_gettime(CLOCK_MONOTONIC, &now))
+		err_nosys(EXIT_FAILURE, _("could not read monotonic clock"));
+	if (ctl->timeout.tv_sec > time_t_max - now.tv_sec) {
+		ctl->timeout_deadline.tv_sec = time_t_max;
+		saturated = true;
+	} else
+		ctl->timeout_deadline.tv_sec = now.tv_sec + ctl->timeout.tv_sec;
+	ctl->timeout_deadline.tv_nsec = now.tv_nsec + ctl->timeout.tv_nsec;
+	if (ctl->timeout_deadline.tv_nsec >= 1000000000L) {
+		if (saturated || ctl->timeout_deadline.tv_sec == time_t_max)
+			ctl->timeout_deadline.tv_nsec = 999999999L;
+		else {
+			ctl->timeout_deadline.tv_sec++;
+			ctl->timeout_deadline.tv_nsec -= 1000000000L;
+		}
+	}
+
+	return -1;
+#else
