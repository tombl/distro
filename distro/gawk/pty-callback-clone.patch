 /*
- * no_fork --- stand-in for fork() on the pseudo-tty coprocess path.
- *
- * The pty coprocess setup needs setsid()/ioctl(TIOCSCTTY) in the child, which
- * posix_spawn cannot express.  wasm has no /dev/ptmx, so that path is never
- * taken at run time; this keeps it compiling and makes it fail cleanly (the
- * caller then falls back to an ordinary pipe coprocess).
+ * pty_child --- establish the pty session on a callback-clone child stack.
  */
-static pid_t
-no_fork(void)
+struct pty_child_args {
+	int master;
+	int slave;
+	const char *command;
+};
+
+static int
+pty_child(void *data)
 {
-	errno = ENOSYS;
-	return -1;
+	struct pty_child_args *args = data;
+
+	if (setsid() < 0)
+		return 120;
+#ifdef TIOCSCTTY
+	if (ioctl(args->slave, TIOCSCTTY, 0) < 0)
+		return 121;
+#endif
+	if (close(args->master) < 0)
+		return 122;
+	if (dup2(args->slave, STDOUT_FILENO) < 0)
+		return 123;
+	if (dup2(args->slave, STDIN_FILENO) < 0)
+		return 124;
+	if (args->slave != STDIN_FILENO && args->slave != STDOUT_FILENO
+	    && close(args->slave) < 0)
+		return 125;
+
+	/* stderr intentionally remains separate from the pty. */
+	signal(SIGPIPE, SIG_DFL);
+	execl("/bin/sh", "sh", "-c", args->command, NULL);
+	return errno == ENOENT ? 127 : 126;
 }
 
