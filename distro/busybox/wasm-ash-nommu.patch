BusyBox gates ash on !NOMMU because every subshell, pipeline member, command
substitution and external command goes through fork(). Our port replaces
that fork with callback clone (see wasm-ash-callback-clone.patch), so lift
the Kconfig dependency and the compile-time #error.

diff --git a/shell/Config.src b/shell/Config.src
index 5efbf99..2bb6a60 100644
--- a/shell/Config.src
+++ b/shell/Config.src
@@ -15,7 +15,6 @@ choice
 
 # note: cannot use "select ASH" here, it breaks "make allnoconfig"
 config SH_IS_ASH
-	depends on !NOMMU
 	bool "ash"
 	select SHELL_ASH
 	help
@@ -57,7 +56,6 @@ choice
 	"bash" as a supported applet name.
 
 config BASH_IS_ASH
-	depends on !NOMMU
 	bool "ash"
 	select SHELL_ASH
 	help
diff --git a/shell/ash.c b/shell/ash.c
index 9173b86..94f59a5 100644
--- a/shell/ash.c
+++ b/shell/ash.c
@@ -17,12 +17,10 @@
  */
