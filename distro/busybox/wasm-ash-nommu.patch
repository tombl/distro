 //config:	bool #hidden option
-//config:	depends on !NOMMU
 //config:
 //config:config ASH
 //config:	bool "ash (80 kb)"
 //config:	default y
-//config:	depends on !NOMMU
 //config:	select SHELL_ASH
 //config:	help
 //config:	The most complete and most pedantically correct shell included with
@@ -31,9 +29,7 @@
