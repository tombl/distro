+/*
+ * WebAssembly Linux has no fork().  Children are created with posix_spawn
+ * (clone + execve); the fd plumbing the old fork children performed between
+ * fork() and exec() is expressed as posix_spawn file actions by the callers,
+ * and SIGPIPE is reset to its default disposition in the child, as the
+ * compressor fork path did (and as is correct for a process on a pipe).
+ *
+ * spawn_argv() runs PATH via posix_spawnp; spawn_shell_command() is the
+ * posix_spawn analogue of xexec(), running "/bin/sh -c CMD".  Both return the
+ * child pid, or -1 with errno set.
+ */
+static pid_t
+spawn_argv (const char *path, char *const argv[],
+	    posix_spawn_file_actions_t *fa)
+{
+  pid_t pid;
+  posix_spawnattr_t attr;
+  sigset_t sigpipe;
+  int rc;
+
+  posix_spawnattr_init (&attr);
+  sigemptyset (&sigpipe);
+  sigaddset (&sigpipe, SIGPIPE);
+  posix_spawnattr_setsigdefault (&attr, &sigpipe);
+  posix_spawnattr_setflags (&attr, POSIX_SPAWN_SETSIGDEF);
+  rc = posix_spawnp (&pid, path, fa, &attr, argv, environ);
+  posix_spawnattr_destroy (&attr);
+  if (rc != 0)
+    {
+      errno = rc;
+      return -1;
+    }
+  return pid;
+}
+
+static pid_t
+spawn_shell_command (const char *cmd, posix_spawn_file_actions_t *fa)
+{
+  char *argv[] = { (char *) "/bin/sh", (char *) "-c", (char *) cmd, NULL };
+  return spawn_argv ("/bin/sh", argv, fa);
+}
