-xfork (void)
+xclone (int (*child_function) (void *), void *child_argument)
 {
+#if defined __wasm__
+  enum { CHILD_STACK_SIZE = 64 * 1024 };
+  void *child_stack = xmalloc (CHILD_STACK_SIZE);
+  pid_t p = clone (child_function,
+		   (char *) child_stack + CHILD_STACK_SIZE,
+		   SIGCHLD, child_argument);
+  int e = errno;
+
+  free (child_stack);
+  errno = e;
+  if (p == (pid_t) -1)
+    call_arg_fatal ("clone", _("child process"));
+#else
   pid_t p = fork ();
+  if (p == 0)
+    _exit (child_function (child_argument));
   if (p == (pid_t) -1)
     call_arg_fatal ("fork", _("child process"));
+#endif
   return p;
 }
 
