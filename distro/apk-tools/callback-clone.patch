+/* Retained for libapk compatibility. New child work should use the callback
+ * form below, which maps to wasm Linux's clone ABI. */
 pid_t apk_process_fork(struct apk_process *p)
 {
+#ifndef __wasm__
 	pid_t pid = fork();
 	if (pid < 0) return pid;
 	if (pid == 0) {
@@ -153,5 +159,61 @@ pid_t apk_process_fork(struct apk_process *p)
 	close_fd(&p->pipe_stderr[1]);
 	return pid;
+#else
+	errno = ENOSYS;
+	return -1;
+#endif
+}
+
+struct apk_clone_child {
+	struct apk_process *process;
+	int (*fn)(void *);
+	void *arg;
+};
+
+static int apk_process_clone_child(void *arg)
+{
+	struct apk_clone_child *child = arg;
+	struct apk_process *p = child->process;
+
+	dup2(p->pipe_stdin[0], STDIN_FILENO);
+	dup2(p->pipe_stdout[1], STDOUT_FILENO);
+	dup2(p->pipe_stderr[1], STDERR_FILENO);
+	close_fd(&p->pipe_stdin[1]);
+	close_fd(&p->pipe_stdout[0]);
+	close_fd(&p->pipe_stderr[0]);
+	return child->fn(child->arg);
+}
+
+pid_t apk_process_clone(struct apk_process *p, int (*child_fn)(void *), void *child_arg)
+{
+	struct apk_clone_child child = {
+		.process = p,
+		.fn = child_fn,
+		.arg = child_arg,
+	};
+	pid_t pid;
+
+#ifdef __wasm__
+	enum { CHILD_STACK_SIZE = 64 * 1024 };
+	void *child_stack = malloc(CHILD_STACK_SIZE);
+	if (!child_stack) return -1;
+
+	pid = clone(apk_process_clone_child,
+		(char *) child_stack + CHILD_STACK_SIZE, SIGCHLD, &child);
+	int saved_errno = errno;
+	free(child_stack);
+	errno = saved_errno;
+#else
+	pid = fork();
+	if (pid == 0) _exit(apk_process_clone_child(&child));
+#endif
+	if (pid < 0) return pid;
+
+	p->pid = pid;
+	close_fd(&p->pipe_stdin[0]);
+	close_fd(&p->pipe_stdout[1]);
+	close_fd(&p->pipe_stderr[1]);
+	return pid;
 }
 
